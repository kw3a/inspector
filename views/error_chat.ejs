<div class="flex justify-between items-center text-shark-400 text-xs">
  <p><%= error.time %></p>
  <p class="opacity-60">#<%= error.error_id %></p>
</div>
<p class="font-semibold text-center text-shark-50 mt-2 mb-2"><%= error.cmd_error%></p>
<div id="err-sse-gen"></div>
<p id="error-summary" class="text-orange-300 text-sm leading-relaxed"></p>
<div class="flex justify-center mt-3">
  <button 
  class="rounded bg-shark-700 hover:bg-shark-600 text-orange-300 px-3 py-1 text-sm border border-shark-800"
  hx-get="/analize/<%= command.id %>/<%= error.error_id %>" hx-target="#err-sse-gen">Analyze</button>
</div>
