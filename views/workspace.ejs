<div id="chat-container" class="flex flex-row divide-x divide-shark-900">
  <div id="command-chat" class="w-1/2 p-4">
    <div class="border-b border-shark-900 pb-2 mb-3">
      <h2 class="text-sm font-semibold text-shark-200 tracking-tight">Command</h2>
    </div>
    <%- include('command_chat', {command: command}); %>
  </div>
  <div id="error-chat" class="w-1/2 p-4">
    <div class="border-b border-shark-900 pb-2 mb-3">
      <h2 class="text-sm font-semibold text-shark-200 tracking-tight">Error Details</h2>
    </div>
  </div>
  
</div>
<div class="mt-4">
  <%- include('error_list', {command: command, errors: command.errors}); %>
</div>
