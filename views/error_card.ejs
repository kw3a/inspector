<div 
class="bg-shark-900/60 p-3 rounded border border-shark-800 text-orange-300 hover:bg-shark-800 transition-colors duration-150 cursor-pointer"
hx-get="/errorchat/<%= command.id %>/<%= error.error_id %>" hx-trigger="click" hx-target="#error-chat">
  <div class="flex justify-between items-center text-shark-400 text-xs">
    <p class="truncate"> <%= error.time %></p>
    <p class="opacity-60 truncate"> #<%= error.error_id %></p>
  </div>
  <p class="mt-1 text-sm leading-snug"> <%= error.cmd_error %></p>
</div>
