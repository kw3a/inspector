<div class="flex justify-between items-center text-shark-400 text-xs">
  <p><%= command.time %></p>
  <p class="opacity-60">#<%= command.id %></p>
</div>
<p class="font-semibold text-center text-shark-50 mt-2 mb-2"><%= command.command %></p>
<div id="cmd-sse-gen"></div>
<p id="command-summary" class="text-blue-300 text-sm leading-relaxed"></p>
<div class="flex justify-center mt-3">
  <button 
  class="rounded bg-shark-700 hover:bg-shark-600 text-blue-300 px-3 py-1 text-sm border border-shark-800"
  hx-get="analize/<%= command.id %>" hx-target="#cmd-sse-gen">Analyze</button>
</div>
