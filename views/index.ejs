<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <!-- Font: Inter for a modern, clean UI -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="output.css" rel="stylesheet">
  <script src="https://unpkg.com/htmx.org@2.0.1"
    integrity="sha384-QWGpdj554B4ETpJJC9z+ZHJcA/i59TyjxEPXiiUgN2WmTyV5OEZWCD6gQhgkdpB/"
    crossorigin="anonymous"></script>

  <script src="https://unpkg.com/htmx-ext-sse@2.2.1/sse.js"></script>
</head>

<body>
  <div class="flex flex-col h-screen bg-shark-950 text-shark-100">
    <!-- Header -->
    <header class="flex items-center justify-between px-4 py-3 border-b border-shark-900 bg-shark-950/60 backdrop-blur">
      <div class="flex items-center gap-2">
        <div class="h-5 w-5 rounded-sm bg-shark-600"></div>
        <h1 class="text-sm sm:text-base font-semibold tracking-tight">Terminal Inspector</h1>
      </div>
      <div class="text-xs text-shark-400">Live command monitor</div>
    </header>

    <!-- Main -->
    <div class="flex-1 flex h-full divide-x divide-shark-900">
      <%- include('command_list', {commands: commands}); %>
      <div id="workspace" class="flex-1 overflow-y-auto p-4 bg-shark-950">
        <div class="h-full grid place-items-center text-shark-400">
          <p class="text-sm">Select a command to view details</p>
        </div>
      </div>
    </div>
  </div>
</body>

</html>
