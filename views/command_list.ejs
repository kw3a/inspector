<div class="w-1/3 bg-shark-950">
  <div class="sticky top-0 z-10 bg-shark-950/80 backdrop-blur px-4 py-3 border-b border-shark-900">
    <p class="text-sm font-semibold tracking-tight text-shark-200">Commands</p>
  </div>
  <div id="command-list" class="flex flex-col overflow-y-auto p-2 gap-2">
    <% if (commands.size > 0) { %>
      <% commands.forEach(command=> { %>
          <%- include('command_card', {command: command}); %>
      <% }) %>
    <% } else { %>
      <p class="text-sm text-shark-500 px-2">No commands yet</p>
    <% } %>
    <div hx-ext="sse" sse-connect="/newcommands" sse-swap="message" hx-target="#command-list" hx-swap="afterbegin">
    </div>
  </div>
</div>
